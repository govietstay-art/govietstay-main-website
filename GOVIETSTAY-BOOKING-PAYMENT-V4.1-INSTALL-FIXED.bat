@echo off
setlocal EnableExtensions EnableDelayedExpansion
chcp 65001 >nul
title GoVietStay - Booking Payment V4 Installer

echo.
echo ======================================================================
echo   GOVIETSTAY - BOOKING PAYMENT V4.1 - ONE CLICK INSTALL (CMD LENGTH FIX)
echo ======================================================================
echo.
echo   This installer will:
echo   - Add /admin/payments Payment Center
echo   - Add /pay/[token] customer payment route
echo   - Connect Payment button into Booking Master / Operations
echo   - Separate Deposit Required from Actual Received
echo   - Show real Received and Balance from booking_financials
echo   - Keep Deposit Waive / Exception for Owner/Admin
echo   - Build check BEFORE push
echo   - Push main only if build succeeds
echo.
echo   Supabase Payment V4 backend / VietQR / PayPal are already configured.
echo.

set "PROJECT="
for /f "delims=" %%I in ('git rev-parse --show-toplevel 2^>nul') do set "PROJECT=%%I"
if not defined PROJECT if exist "%USERPROFILE%\govietstay-main-website\.git" set "PROJECT=%USERPROFILE%\govietstay-main-website"
if not defined PROJECT if exist "%USERPROFILE%\Desktop\govietstay-main-website\.git" set "PROJECT=%USERPROFILE%\Desktop\govietstay-main-website"
if not defined PROJECT if exist "%USERPROFILE%\Documents\govietstay-main-website\.git" set "PROJECT=%USERPROFILE%\Documents\govietstay-main-website"

if not defined PROJECT (
  echo Khong tu tim thay thu muc project.
  set /p "PROJECT=Dan duong dan thu muc govietstay-main-website roi Enter: "
)

if not exist "%PROJECT%\.git" (
  echo.
  echo [STOP] Khong tim thay Git project: %PROJECT%
  pause
  exit /b 1
)

where git >nul 2>&1
if errorlevel 1 (
  echo [STOP] May chua co Git trong PATH.
  pause
  exit /b 1
)

set "WORKTREE=%TEMP%\gvs_payment_v4_%RANDOM%_%RANDOM%"
set "GVS_WORKTREE=%WORKTREE%"

echo [1/8] Fetch origin/main...
git -C "%PROJECT%" fetch origin main
if errorlevel 1 goto FAIL

echo [2/8] Tao clean worktree tu origin/main...
git -C "%PROJECT%" worktree add --detach "%WORKTREE%" origin/main
if errorlevel 1 goto FAIL

echo [3/8] Tao Payment Center + payment routes + patch Booking Master...
set "PAYLOAD_B64=%TEMP%\gvs_payment_v4_%RANDOM%_%RANDOM%.b64"
