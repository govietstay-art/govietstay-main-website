)
powershell -NoProfile -ExecutionPolicy Bypass -Command "$b=(Get-Content -Raw $env:PAYLOAD_B64) -replace '\s',''; $s=[Text.Encoding]::Unicode.GetString([Convert]::FromBase64String($b)); $p=Join-Path $env:TEMP ('gvs_payment_v4_'+[guid]::NewGuid().ToString('N')+'.ps1'); [IO.File]::WriteAllText($p,$s,(New-Object Text.UTF8Encoding($false))); & powershell -NoProfile -ExecutionPolicy Bypass -File $p; $rc=$LASTEXITCODE; Remove-Item -Force $p -ErrorAction SilentlyContinue; exit $rc"
set "RC=%ERRORLEVEL%"
del /q "%PAYLOAD_B64%" >nul 2>&1
if not "%RC%"=="0" exit /b %RC%
if errorlevel 1 goto FAIL_WORKTREE

echo [4/8] Dung dependencies hien co neu co...
if exist "%PROJECT%\node_modules" (
  cmd /c mklink /J "%WORKTREE%\node_modules" "%PROJECT%\node_modules" >nul 2>&1
) else (
  pushd "%WORKTREE%"
  if exist package-lock.json (call npm ci) else (call npm install)
  if errorlevel 1 (popd & goto FAIL_WORKTREE)
  popd
)

echo [5/8] Production build check...
pushd "%WORKTREE%"
call npm run build
if errorlevel 1 (
  popd
  echo.
  echo [STOP] BUILD FAILED. Khong push production.
  goto FAIL_WORKTREE
)
popd

echo [6/8] Stage Payment V4 files...
git -C "%WORKTREE%" add -- "components/admin-v5/OperationsCenter.tsx" "components/admin-v5/PaymentCenter.tsx" "components/admin-v5/payment-v4.css" "app/admin/payments/page.tsx" "app/pay/[token]/page.tsx"
git -C "%WORKTREE%" diff --cached --quiet
if not errorlevel 1 (
  echo [OK] Payment V4 code da giong origin/main. Khong co gi can push.
  goto CLEAN_SUCCESS
)

echo [7/8] Commit...
git -C "%WORKTREE%" -c user.name="GoVietStay Installer" -c user.email="govietstay@gmail.com" commit -m "feat(payments): connect Booking Payment V4 to Operations"
if errorlevel 1 goto FAIL_WORKTREE

echo [8/8] Push main - Vercel se auto deploy...
git -C "%WORKTREE%" push origin HEAD:main
if errorlevel 1 goto FAIL_WORKTREE

:CLEAN_SUCCESS
echo.
echo ======================================================================
echo   SUCCESS - BOOKING PAYMENT V4.1 INSTALLED
echo ======================================================================
echo.
echo   Kiem tra sau khi Vercel deploy:
echo   1. https://www.govietstay.com/admin/operations
echo   2. Bam "Payment Center" hoac nut "Payment" tren booking
echo   3. Payment Center: https://www.govietstay.com/admin/payments
echo   4. Tao deposit link - link khach se co dang:
echo      https://www.govietstay.com/pay/xxxxxxxxxxxxxxxx
echo.
echo   Logic:
echo   - Deposit Required = so tien YEU CAU coc
echo   - Actual Received = so tien THUC TE da nhan
echo   - Balance = Total - Actual Received
echo   - Waive = ngoai le, KHONG ghi gia la da nhan tien
echo.
git -C "%PROJECT%" worktree remove --force "%WORKTREE%" >nul 2>&1
if exist "%WORKTREE%" rmdir /s /q "%WORKTREE%" >nul 2>&1
pause
exit /b 0

:FAIL_WORKTREE
echo.
echo [FAILED] Co loi. Production CHUA duoc push neu build/commit chua thanh cong.
git -C "%PROJECT%" worktree remove --force "%WORKTREE%" >nul 2>&1
if exist "%WORKTREE%" rmdir /s /q "%WORKTREE%" >nul 2>&1
pause
exit /b 1

:FAIL
echo.
echo [FAILED] Khong tao duoc clean worktree.
pause
exit /b 1
