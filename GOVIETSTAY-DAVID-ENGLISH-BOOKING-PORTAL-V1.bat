@echo off
setlocal EnableExtensions EnableDelayedExpansion
chcp 65001 >nul
title GoVietStay - David English Booking Portal

echo.
echo ================================================================
echo  GOVIETSTAY - DAVID DIRECT BOOKING PORTAL - ENGLISH
echo ================================================================
echo.
echo  Route: /en/David
echo  Source: GVS-EN-DAVID-00
echo  Flow: David submit - Pending - Admin Approve - Booking Master
echo        - Operations - Finance
echo  David direct bookings are tracked separately from employee Payroll.
echo.
echo  Backend profile/linking is already configured in Supabase.
echo.

set "PROJECT="
for /f "delims=" %%I in ('git rev-parse --show-toplevel 2^>nul') do set "PROJECT=%%I"
if not defined PROJECT if exist "%USERPROFILE%\Documents\GitHub\govietstay-main-website\.git" set "PROJECT=%USERPROFILE%\Documents\GitHub\govietstay-main-website"
if not defined PROJECT if exist "%USERPROFILE%\govietstay-main-website\.git" set "PROJECT=%USERPROFILE%\govietstay-main-website"
if not defined PROJECT if exist "%USERPROFILE%\Desktop\govietstay-main-website\.git" set "PROJECT=%USERPROFILE%\Desktop\govietstay-main-website"

if not defined PROJECT (
  set /p "PROJECT=Project path: "
)
if not exist "%PROJECT%\.git" (
  echo [STOP] Git project not found: %PROJECT%
  pause
  exit /b 1
)

set "WORKTREE=%TEMP%\gvs_david_portal_%RANDOM%_%RANDOM%"
set "GVS_WORKTREE=%WORKTREE%"

echo [1/7] Fetch origin/main...
git -C "%PROJECT%" fetch origin main
if errorlevel 1 goto FAIL

echo [2/7] Create clean worktree...
git -C "%PROJECT%" worktree add --detach "%WORKTREE%" origin/main
if errorlevel 1 goto FAIL

echo [3/7] Create English David portal...
set "PATCH_B64=%TEMP%\gvs_david_portal_%RANDOM%_%RANDOM%.b64"
set "PATCH_PS1=%TEMP%\gvs_david_portal_%RANDOM%_%RANDOM%.ps1"
> "%PATCH_B64%" (
  echo 
  echo 
  echo 
  echo 
  echo 
  echo 
  echo 
  echo 
  echo 
  echo 
  echo 
  echo 
  echo Sm9pbi1QYXRoICRkaXIgInBhZ2UudHN4IiksJHRzeCwkdXRmOCkKW0lPLkZpbGVdOjpXcml0ZUFsbFRleHQoKEpvaW4tUGF0aCAkZGlyICJEYXZpZFBhZ2UubW9kdWxlLmNzcyIpLCRjc3MsJHV0ZjgpCldyaXRlLUhvc3QgIltPS10gRGF2aWQgRW5nbGlzaCBkaXJlY3QgYm9va2luZyBwb3J0YWwgY3JlYXRlZC4iIC1Gb3JlZ3JvdW5kQ29sb3IgR3JlZW4K
)
certutil -f -decode "%PATCH_B64%" "%PATCH_PS1%" >nul
if errorlevel 1 goto FAIL_WORKTREE
powershell -NoProfile -ExecutionPolicy Bypass -File "%PATCH_PS1%"
set "PATCH_RC=%ERRORLEVEL%"
del /q "%PATCH_B64%" "%PATCH_PS1%" >nul 2>&1
if not "%PATCH_RC%"=="0" goto FAIL_WORKTREE

if exist "%PROJECT%\.env.local" copy /Y "%PROJECT%\.env.local" "%WORKTREE%\.env.local" >nul
if exist "%PROJECT%\node_modules" (
  echo [4/7] Reuse node_modules...
  cmd /c mklink /J "%WORKTREE%\node_modules" "%PROJECT%\node_modules" >nul 2>&1
) else (
  echo [4/7] Install dependencies...
  pushd "%WORKTREE%"
  if exist package-lock.json (call npm ci) else (call npm install)
  if errorlevel 1 (popd & goto FAIL_WORKTREE)
  popd
)

echo [5/7] Production build check...
pushd "%WORKTREE%"
call npm run build
if errorlevel 1 (
  popd
  echo [STOP] BUILD FAILED. Nothing pushed.
  goto FAIL_WORKTREE
)
popd

echo [6/7] Commit portal...
git -C "%WORKTREE%" add -- "app/en/David/page.tsx" "app/en/David/DavidPage.module.css"
git -C "%WORKTREE%" diff --cached --quiet
if not errorlevel 1 goto CLEAN_SUCCESS
git -C "%WORKTREE%" -c user.name="GoVietStay Installer" -c user.email="govietstay@gmail.com" commit -m "feat(owner): add David English direct booking portal" -- "app/en/David/page.tsx" "app/en/David/DavidPage.module.css"
if errorlevel 1 goto FAIL_WORKTREE

echo [7/7] Push main - Vercel auto deploy...
git -C "%WORKTREE%" push origin HEAD:main
if errorlevel 1 goto FAIL_WORKTREE

:CLEAN_SUCCESS
echo.
echo ================================================================
echo  SUCCESS - DAVID ENGLISH BOOKING PORTAL
echo ================================================================
echo  Open:
echo  https://www.govietstay.com/en/David
echo.
echo  Test flow:
echo  1. Fill one test booking
echo  2. Save Booking Request to Admin
echo  3. Admin - Sales Team / Payroll - Staff Booking Requests
echo  4. Approve
echo  5. Booking appears in Booking Master / Operations with David source
echo.
git -C "%PROJECT%" worktree remove --force "%WORKTREE%" >nul 2>&1
git -C "%PROJECT%" worktree prune >nul 2>&1
pause
exit /b 0

:FAIL_WORKTREE
echo.
echo [STOP] Error. Nothing pushed.
git -C "%PROJECT%" worktree remove --force "%WORKTREE%" >nul 2>&1
git -C "%PROJECT%" worktree prune >nul 2>&1
pause
exit /b 1

:FAIL
echo.
echo [STOP] Could not prepare source.
pause
exit /b 1
