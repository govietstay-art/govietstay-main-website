@echo off
setlocal EnableExtensions
title GoVietStay - Install Yandex Metrika 112457261
cd /d "%~dp0"

echo ============================================================
echo   GoVietStay - Install Yandex Metrika
echo   Counter ID: 112457261
echo ============================================================
echo.

if not exist ".git" (
  echo [ERROR] Put this BAT file in the ROOT folder:
  echo         govietstay-main-website
  echo.
  pause
  exit /b 1
)

if not exist "app\layout.tsx" (
  echo [ERROR] app\layout.tsx not found.
  echo This installer is made for the current GoVietStay project.
  pause
  exit /b 1
)

if not exist "components" mkdir "components"

echo [1/5] Creating components\YandexMetrika.tsx ...
powershell -NoProfile -ExecutionPolicy Bypass -Command "[IO.File]::WriteAllBytes('components\YandexMetrika.tsx',[Convert]::FromBase64String(''))"
if errorlevel 1 (
  echo [ERROR] Could not create YandexMetrika component.
  pause
  exit /b 1
)

echo.
echo [2/5] Updating app\layout.tsx safely ...
powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
if errorlevel 1 (
  echo.
  echo [ERROR] Layout update failed. No Git push was done.
  pause
  exit /b 1
)

echo.
echo [3/5] Checking Git diff ...
git diff -- "app/layout.tsx" "components/YandexMetrika.tsx"
echo.

findstr /C:"112457261" "components\YandexMetrika.tsx" >nul
if errorlevel 1 (
  echo [ERROR] Counter ID check failed.
  pause
  exit /b 1
)

echo [4/5] Commit changes ...
git add "app/layout.tsx" "components/YandexMetrika.tsx"
git diff --cached --quiet
if %errorlevel%==0 (
  echo [INFO] Nothing new to commit. Metrika may already be installed.
) else (
  git commit -m "feat: install Yandex Metrika counter 112457261"
  if errorlevel 1 (
    echo [ERROR] Git commit failed.
    pause
    exit /b 1
  )
)

echo.
echo [5/5] Push to GitHub main ...
git push origin main
if errorlevel 1 (
  echo.
  echo [ERROR] Push failed.
  echo Try:
  echo   git pull --rebase origin main
  echo Then run this BAT again.
  pause
  exit /b 1
)

echo.
echo ============================================================
echo   DONE - Yandex Metrika 112457261 installed
echo ============================================================
echo Vercel will deploy automatically.
echo.
echo IMPORTANT:
echo - Keep ssr:true
echo - Keep webvisor:true
echo - Keep ecommerce:"dataLayer"
echo - Counter is installed ONCE in the root layout,
echo   so it covers /, /ru, /en, /ko, /it and other pages.
echo.
echo After Vercel deployment is READY:
echo   1. Open Yandex Metrika
echo   2. Click "Check tag"
echo   3. Then click "Get started"
echo.
pause
