:root{--ink:#12322a;--green:#0e6b55;--mint:#a9d8c8;--cream:#f7f0df;--coral:#ef785f;--gold:#efb84e;--paper:#fffdf7}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--cream);color:var(--ink);font-family:Arial,Helvetica,sans-serif}a{text-decoration:none;color:inherit}button,input{font:inherit}.hero{min-height:760px;position:relative;overflow:hidden;color:white;background:radial-gradient(circle at 78% 25%,#f7b85f 0 9%,transparent 30%),linear-gradient(145deg,#073e35 0 56%,#0f795e 56% 69%,#efa958 69% 100%)}.hero:before{content:"";position:absolute;width:680px;height:680px;border:90px solid rgba(255,255,255,.08);border-radius:48% 52% 62% 38%;right:-140px;top:70px;transform:rotate(18deg)}header,.heroCopy,.section,.highlightGrid,.warning{width:min(1160px,90vw);margin:auto}.hero header{height:92px;display:flex;align-items:center;justify-content:space-between;position:relative;z-index:2}.brand{display:flex;align-items:center;gap:10px;font-weight:800}.brand b{display:grid;place-items:center;width:42px;height:42px;border-radius:50%;background:#fff;color:var(--green);font:26px Georgia}.navCta{border:1px solid #ffffff80;border-radius:999px;padding:12px 18px;font-weight:800;font-size:13px}.heroCopy{position:relative;z-index:2;padding-top:115px}.eyebrow,.label{text-transform:uppercase;letter-spacing:.17em;font-size:12px;font-weight:900}.eyebrow{color:#ffe09a}.hero h1{font:500 clamp(58px,7.5vw,104px)/.9 Georgia,serif;letter-spacing:-.055em;margin:22px 0 28px}.hero h1 em{font-style:italic;color:#ffd47e}.lead{font-size:19px;line-height:1.65;max-width:630px;color:#e1eee9}.chips{display:flex;gap:10px;flex-wrap:wrap;margin-top:30px}.chips span{padding:10px 14px;background:#ffffff18;border:1px solid #ffffff30;border-radius:999px;font-size:12px;font-weight:800}.river{position:absolute;bottom:-20px;left:-5%;width:110%;height:135px;background:#69bdaa;border-radius:50% 50% 0 0/25% 25% 0 0;opacity:.75}.river i{position:absolute;width:120px;height:2px;background:#fff6;left:15%;top:40px}.river i:nth-child(2){left:35%;top:70px}.river i:nth-child(3){left:58%;top:35px}.river i:nth-child(4){left:76%;top:80px}.river i:nth-child(5){left:89%;top:45px}.section{padding:100px 0}.intro{display:grid;grid-template-columns:1.1fr .9fr;gap:90px;align-items:end}.label{color:var(--green);margin:0 0 16px}.section h2,.splitLists h2,.final h2{font:500 clamp(40px,5vw,66px)/1.03 Georgia,serif;letter-spacing:-.04em;margin:0}.intro>p,.muted{color:#60766e;line-height:1.7}.highlightGrid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;padding-bottom:100px}.highlightGrid article{background:var(--paper);padding:28px;border-radius:22px;min-height:245px;box-shadow:0 12px 30px #12322a0c}.highlightGrid article>span{color:var(--coral);font:24px Georgia}.highlightGrid h3{font:26px Georgia;margin:35px 0 13px}.highlightGrid p{font-size:14px;line-height:1.65;color:#62776f}.schedule{border-top:1px solid #d8dfd8}.schedule>h2{max-width:780px}.timeline{max-width:900px;margin:60px 0 0 auto}.timeline article{display:grid;grid-template-columns:155px 38px 1fr;gap:20px;min-height:112px}.timeline time{font-weight:900;color:var(--green);padding-top:7px}.timeline i{font-style:normal;width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:var(--coral);color:white;position:relative}.timeline i:after{content:"";position:absolute;width:1px;top:38px;bottom:-70px;background:#bfcac5}.timeline article:last-child i:after{display:none}.timeline h3{margin:4px 0 7px;font-size:19px}.timeline p{margin:0;color:#657870;line-height:1.55;font-size:14px}.warning{display:flex;gap:22px;background:#fff1e8;border:2px solid #f2aa91;border-radius:22px;padding:29px 32px;margin-bottom:100px}.warning>div{width:45px;height:45px;border-radius:50%;background:var(--coral);color:#fff;display:grid;place-items:center;font-weight:900;font-size:22px;flex:none}.warning h3{margin:1px 0 9px}.warning p{margin:0;color:#755f56;line-height:1.65;font-size:14px}.splitLists{display:grid;grid-template-columns:1fr 1fr}.splitLists>div{padding:85px max(6vw,calc((100vw - 1160px)/2))}.included{background:#073e35;color:white}.excluded{background:#eadfc7}.included .label{color:#82d9bd}.splitLists h2{font-size:50px;margin-bottom:35px}.splitLists ul{list-style:none;padding:0;display:grid;gap:14px}.splitLists li{display:flex;gap:12px;line-height:1.45}.included li{color:#7ee0bc}.included li span{color:#d9ebe4}.excluded li{color:var(--coral)}.excluded li span{color:var(--ink)}.priceBooking{display:grid;grid-template-columns:1fr 440px;gap:90px;align-items:center}.prices{display:grid;grid-template-columns:1fr 1fr;gap:15px;margin:40px 0 25px}.prices article{background:#fff;padding:24px;border-radius:18px}.prices span,.prices strong,.prices small{display:block}.prices span{font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.12em;color:#667a72}.prices strong{font:39px Georgia;color:var(--green);margin:10px 0 5px}.formCard{background:#fff;padding:32px;border-radius:25px;box-shadow:0 20px 50px #12322a16}.formCard label{display:block;font-size:12px;font-weight:900;margin-top:14px}.formCard input{width:100%;margin-top:7px;padding:13px;border:1px solid #cad5cf;border-radius:11px;background:#fbf8ef;color:var(--ink)}.formRow{display:grid;grid-template-columns:1fr 1fr;gap:12px}.formCard>a,.final>a{display:block;text-align:center;background:#20a65a;color:white;padding:16px;border-radius:999px;font-weight:900;margin-top:23px}.formCard small{display:block;text-align:center;color:#788881;margin-top:11px;line-height:1.4}.reviews{background:#fff}.reviews .section>h2{max-width:720px}.reviewGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:17px;margin-top:45px}.reviewGrid article{border:1px solid #dce3de;border-radius:22px;padding:25px;background:#fbfcfa;display:flex;flex-direction:column;min-height:330px}.stars{color:#f1aa28;letter-spacing:3px}.reviewGrid blockquote{font:20px/1.52 Georgia;margin:20px 0}.reviewGrid footer{margin-top:auto;padding-top:18px;border-top:1px solid #dce3de;display:flex;justify-content:space-between;gap:12px;align-items:end}.reviewGrid footer a{font-size:12px;color:var(--green);text-decoration:underline;font-weight:800}.faq{max-width:900px}.faq h2{margin-bottom:45px}.faq details{border-top:1px solid #cbd5d0;padding:20px 0}.faq summary{cursor:pointer;display:flex;justify-content:space-between;font-weight:800;list-style:none}.faq details p{color:#657870;line-height:1.65}.final{text-align:center;background:#073e35;color:white;padding:100px 5vw}.final h2{max-width:850px;margin:20px auto}.final>p{color:#b8d5ca}.final>a{width:260px;margin:30px auto 0}@media(max-width:850px){.hero{min-height:690px}.heroCopy{padding-top:75px}.intro,.priceBooking{grid-template-columns:1fr;gap:30px}.highlightGrid,.reviewGrid{grid-template-columns:1fr 1fr}.splitLists{grid-template-columns:1fr}.priceBooking{gap:50px}}@media(max-width:560px){.hero{min-height:720px}.hero h1{font-size:52px}.hero header{height:76px}.brand span{font-size:15px}.navCta{padding:10px 12px}.section{padding:72px 0}.highlightGrid,.reviewGrid{grid-template-columns:1fr}.highlightGrid{padding-bottom:70px}.timeline article{grid-template-columns:105px 30px 1fr;gap:10px}.timeline i{width:28px;height:28px}.timeline i:after{top:32px}.warning{width:92vw;padding:22px 18px;margin-bottom:70px}.splitLists>div{padding:65px 6vw}.prices{grid-template-columns:1fr}.formCard{padding:23px}.reviewGrid article{min-height:auto}.final{padding:75px 5vw}}

/* Photo-led hero update */
.hero{min-height:780px;background:linear-gradient(120deg,#052f27 0 47%,#0e6b55 100%)}.hero:before{display:none}.heroCopy{padding-top:112px;padding-right:48%;}.hero h1{font-size:clamp(54px,5.9vw,86px)}.heroVisuals{position:absolute;z-index:1;right:4.5vw;top:112px;width:min(620px,45vw);height:590px}.heroVisuals img{position:absolute;display:block;object-fit:cover;border:5px solid rgba(255,255,255,.92);box-shadow:0 24px 60px rgba(0,0,0,.35)}.heroMainPhoto{right:0;top:0;width:72%;height:78%;border-radius:32px}.heroOldTownPhoto{left:0;bottom:0;width:42%;height:45%;border-radius:24px}.heroLanternPhoto{right:2%;bottom:0;width:48%;height:32%;border-radius:22px}.hero:after{content:"";position:absolute;inset:auto 0 0;height:120px;background:linear-gradient(0deg,var(--cream),transparent)}
@media(max-width:900px){.hero{min-height:980px}.heroCopy{padding:60px 0 0}.heroVisuals{position:relative;right:auto;top:auto;width:90vw;height:430px;margin:55px auto 0}.heroMainPhoto{width:65%;height:88%}.heroOldTownPhoto{width:38%;height:48%}.heroLanternPhoto{width:42%;height:38%}}
@media(max-width:560px){.hero{min-height:930px}.heroCopy{padding-top:45px}.hero h1{font-size:48px}.heroVisuals{height:380px;margin-top:45px}.heroMainPhoto{width:72%;height:78%;border-radius:22px}.heroOldTownPhoto{width:42%;height:42%;border-radius:18px}.heroLanternPhoto{width:48%;height:30%;border-radius:16px}.heroVisuals img{border-width:3px}}
