@echo off
setlocal EnableExtensions EnableDelayedExpansion
chcp 65001 >nul
title GoVietStay - Remove Phu Quoc Hero Logo ONLY

set "REPO=%USERPROFILE%\Documents\GitHub\govietstay-main-website"
if not exist "%REPO%\package.json" (
  if exist "%USERPROFILE%\OneDrive\Documents\GitHub\govietstay-main-website\package.json" (
    set "REPO=%USERPROFILE%\OneDrive\Documents\GitHub\govietstay-main-website"
  ) else if exist "%CD%\package.json" (
    set "REPO=%CD%"
  ) else (
    echo [STOP] Khong tim thay project govietstay-main-website.
    echo Thu muc du kien:
    echo   %%USERPROFILE%%\Documents\GitHub\govietstay-main-website
    echo hoac chay BAT ngay trong project.
    pause
    exit /b 1
  )
)

cd /d "%REPO%"
set "TARGET=components\PhuQuocJohnsCatalog.tsx"

echo.
echo ============================================================
echo   GOVIETSTAY - REMOVE HERO IMAGE LOGO ONLY
echo   EN: /tours/phu-quoc
echo   RU: /ru/tours/phu-quoc
echo   Target: components/PhuQuocJohnsCatalog.tsx
echo ============================================================
echo.

for /f "delims=" %%B in ('git branch --show-current') do set "BRANCH=%%B"
if /i not "!BRANCH!"=="main" (
  echo [STOP] Dang o branch !BRANCH!, can branch main.
  pause
  exit /b 1
)

if not exist "%TARGET%" (
  echo [STOP] Khong tim thay %TARGET%
  pause
  exit /b 1
)

git diff --quiet -- "%TARGET%"
if errorlevel 1 (
  echo [STOP] %TARGET% dang co thay doi chua commit.
  echo De tranh ghi de code dang lam, BAT dung tai day.
  git diff -- "%TARGET%"
  pause
  exit /b 1
)

git diff --cached --quiet -- "%TARGET%"
if errorlevel 1 (
  echo [STOP] %TARGET% dang duoc stage tu truoc.
  pause
  exit /b 1
)

echo [1/5] Xoa CHI logo card mau trang de tren anh hero...
set "GVS_ROOT=%REPO%"
powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
set "PATCHCODE=%ERRORLEVEL%"

if "%PATCHCODE%"=="10" (
  echo.
  echo [OK] Trang da chi con 1 logo. Khong can sua them.
  pause
  exit /b 0
)
if not "%PATCHCODE%"=="0" (
  echo.
  echo [STOP] Khong sua file vi khong xac dinh duoc dung logo card.
  pause
  exit /b %PATCHCODE%
)

echo.
echo [2/5] Kiem tra diff...
git diff -- "%TARGET%"

echo.
echo [3/5] Production build...
if exist ".next" rmdir /s /q ".next"
call npm run build
if errorlevel 1 (
  echo.
  echo [FAIL] Build loi. Dang khoi phuc file cu...
  if exist "%TEMP%\PhuQuocJohnsCatalog.before-remove-hero-logo.tsx" (
    copy /y "%TEMP%\PhuQuocJohnsCatalog.before-remove-hero-logo.tsx" "%TARGET%" >nul
    echo [OK] Da khoi phuc component cu.
  )
  echo KHONG commit, KHONG push.
  pause
  exit /b 1
)

echo.
echo [4/5] Stage + commit CHI component Phu Quoc...
git reset >nul 2>&1
git add -- "%TARGET%"

for /f %%C in ('git diff --cached --name-only ^| find /c /v ""') do set "COUNT=%%C"
if not "!COUNT!"=="1" (
  echo [STOP] Expected exactly 1 staged file, found !COUNT!.
  git diff --cached --name-status
  git reset
  pause
  exit /b 1
)

for /f "delims=" %%F in ('git diff --cached --name-only') do set "STAGED=%%F"
if /i not "!STAGED!"=="components/PhuQuocJohnsCatalog.tsx" (
  echo [STOP] Unexpected staged file: !STAGED!
  git reset
  pause
  exit /b 1
)

git commit -m "fix: remove duplicate Phu Quoc logo from hero image"
if errorlevel 1 (
  echo [STOP] Commit failed. Nothing pushed.
  pause
  exit /b 1
)

echo.
echo [5/5] Push main...
git push origin main
if errorlevel 1 (
  echo [STOP] Push failed. Commit van nam o may local.
  pause
  exit /b 1
)

echo.
echo ============================================================
echo   SUCCESS
echo ============================================================
echo - Logo tren TAM HINH hero da bo
echo - Logo chinh tren dau trang giu nguyen
echo - Anh Phu Quoc giu nguyen
echo - WhatsApp va noi dung tour giu nguyen
echo.
echo EN: https://www.govietstay.com/tours/phu-quoc
echo RU: https://www.govietstay.com/ru/tours/phu-quoc
echo.
echo Vercel se tu deploy sau khi GitHub nhan commit.
pause
exit /b 0
