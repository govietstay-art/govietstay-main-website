@echo off
setlocal EnableExtensions EnableDelayedExpansion
chcp 65001 >nul
title GoVietStay - Phu Quoc Partner Master V2 FIX

if /I not "%~1"=="RUN" (
  cmd.exe /k call "%~f0" RUN
  exit /b
)

echo.
echo ================================================================
echo  GOVIETSTAY - PHU QUOC PARTNER MASTER V2 FIX
echo ================================================================
echo.
echo  FIX V2:
echo   - Sua loi "The system cannot execute the specified program"
echo   - Khong dung PowerShell -EncodedCommand dai nua
echo   - Ghi patch ra file tam roi moi chay PowerShell -File
echo   - Van build FULL truoc khi push Production
echo.

set "PROJECT="
for /f "delims=" %%I in ('git rev-parse --show-toplevel 2^>nul') do set "PROJECT=%%I"
if not defined PROJECT if exist "%USERPROFILE%\Documents\GitHub\govietstay-main-website\.git" set "PROJECT=%USERPROFILE%\Documents\GitHub\govietstay-main-website"
if not defined PROJECT if exist "C:\Users\ADMIN\Documents\GitHub\govietstay-main-website\.git" set "PROJECT=C:\Users\ADMIN\Documents\GitHub\govietstay-main-website"
if not defined PROJECT if exist "%USERPROFILE%\govietstay-main-website\.git" set "PROJECT=%USERPROFILE%\govietstay-main-website"
if not defined PROJECT if exist "%USERPROFILE%\Desktop\govietstay-main-website\.git" set "PROJECT=%USERPROFILE%\Desktop\govietstay-main-website"

if not defined PROJECT (
  echo [STOP] Khong tu tim thay govietstay-main-website.
  set /p "PROJECT=Dan full path project roi Enter: "
)

if not exist "%PROJECT%\.git" (
  echo [STOP] Khong phai Git project: %PROJECT%
  pause
  exit /b 1
)

echo [1/9] Fetch source moi nhat origin/main...
git -C "%PROJECT%" fetch origin main
if errorlevel 1 goto FAIL

set "WORKTREE=%TEMP%\gvs_pq_partner_master_v2_%RANDOM%_%RANDOM%"
set "GVS_WORKTREE=%WORKTREE%"
set "B64=%TEMP%\gvs_pq_partner_master_v2_%RANDOM%_%RANDOM%.b64"
set "PS1=%TEMP%\gvs_pq_partner_master_v2_%RANDOM%_%RANDOM%.ps1"

echo [2/9] Tao worktree sach tu origin/main...
git -C "%PROJECT%" worktree add --detach "%WORKTREE%" origin/main
if errorlevel 1 goto FAIL

echo [3/9] Tao file patch tam...
> "%B64%" (
  echo 
  echo 
  echo 
)
if errorlevel 1 goto FAIL_WORKTREE

powershell -NoProfile -ExecutionPolicy Bypass -Command "$b=(Get-Content -Raw -LiteralPath '%B64%') -replace '\s',''; [IO.File]::WriteAllBytes('%PS1%',[Convert]::FromBase64String($b))"
if errorlevel 1 goto FAIL_WORKTREE

echo [4/9] Patch Phu Quoc Sales -^> Partner Master chung...
powershell -NoProfile -ExecutionPolicy Bypass -File "%PS1%"
if errorlevel 1 goto FAIL_WORKTREE

del /q "%B64%" "%PS1%" >nul 2>&1

echo [5/9] Kiem tra diff...
git -C "%WORKTREE%" diff -- "components/admin-v5/PhuQuocSalesHub.tsx"
if errorlevel 1 goto FAIL_WORKTREE

echo.
echo [6/9] Cai dependencies...
call npm --prefix "%WORKTREE%" ci
if errorlevel 1 goto FAIL_WORKTREE

echo [7/9] Build FULL website...
call npm --prefix "%WORKTREE%" run build
if errorlevel 1 goto FAIL_WORKTREE

echo [8/9] Commit patch...
git -C "%WORKTREE%" config user.name "GoVietStay Automation"
git -C "%WORKTREE%" config user.email "govietstay-art@users.noreply.github.com"
git -C "%WORKTREE%" add -- "components/admin-v5/PhuQuocSalesHub.tsx"
git -C "%WORKTREE%" diff --cached --quiet
if not errorlevel 1 (
  echo [OK] Khong co thay doi moi - patch co the da ton tai.
  goto VERIFY
)

git -C "%WORKTREE%" commit -m "feat(admin): connect Phu Quoc Sales to shared Partner Master"
if errorlevel 1 goto FAIL_WORKTREE

echo [9/9] Push main - Vercel se auto deploy...
git -C "%WORKTREE%" push origin HEAD:main
if errorlevel 1 goto FAIL_WORKTREE

:VERIFY
echo.
echo Kiem tra Production /admin...
powershell -NoProfile -ExecutionPolicy Bypass -Command "$u='https://www.govietstay.com/admin'; for($i=1;$i -le 36;$i++){try{$r=Invoke-WebRequest -Uri $u -UseBasicParsing -TimeoutSec 15;if($r.StatusCode -eq 200){Write-Host '[LIVE] /admin HTTP 200' -ForegroundColor Green;exit 0}}catch{};Write-Host ('Waiting Vercel '+$i+'/36');Start-Sleep 10};exit 1"
if errorlevel 1 echo [WARN] Vercel co the van dang deploy. Khong xem day la loi code.

echo.
echo ================================================================
echo  THANH CONG - V2
echo ================================================================
echo.
echo  Kiem tra:
echo   Admin ^> Phu Quoc Sales ^> Partner QR
echo   - Dropdown Partner Master chung
echo   - Nut + Them Partner
echo   - Tao xong vao Partners thuong / QR
echo   - QR + Poster Phu Quoc dung cung Partner Code
echo   - KHONG co Partner Master thu hai
echo.
start "" "https://www.govietstay.com/admin"

git -C "%PROJECT%" worktree remove --force "%WORKTREE%" >nul 2>&1
del /q "%B64%" "%PS1%" >nul 2>&1
echo.
echo Cua so giu nguyen de anh kiem tra.
pause
exit /b 0

:FAIL_WORKTREE
echo.
echo [STOP] CO LOI - KHONG PUSH LEN PRODUCTION.
echo Worktree giu lai de kiem tra: %WORKTREE%
del /q "%B64%" "%PS1%" >nul 2>&1
echo.
echo Chup man hinh loi gui em. Cua so se KHONG tu tat.
pause
exit /b 1

:FAIL
echo.
echo [STOP] CO LOI TRUOC KHI PATCH/PUSH.
echo Khong co thay doi Production.
del /q "%B64%" "%PS1%" >nul 2>&1
echo.
echo Chup man hinh loi gui em. Cua so se KHONG tu tat.
pause
exit /b 1
