@echo off
setlocal EnableExtensions
chcp 65001 >nul
title GoVietStay - German Market Landing Pages V1

echo.
echo ============================================================
echo   GOVIETSTAY - GERMAN MARKET LANDINGS V1
echo   HELP-FIRST SEO + PRIVATE TOURS ONLY
echo ============================================================
echo.
echo This installer will add:
echo   - German Central Vietnam guides
echo   - German Phu Quoc guides
echo   - official GoVietStay logo only
echo   - German SEO metadata + FAQ/Article schema
echo   - safe root sitemap registration
echo   - backup of every overwritten target
echo.
echo Routes:
echo   /de
echo   /de/zentralvietnam-private-touren
echo   /de/da-nang
echo   /de/hoi-an
echo   /de/hue
echo   /de/zentralvietnam-reiseplan
echo   /de/da-nang-regenzeit
echo   /de/phu-quoc
echo   /de/phu-quoc/beste-reisezeit
echo   /de/phu-quoc/3-oder-4-inseln
echo   /de/phu-quoc/mit-kindern
echo   /de/phu-quoc/individuelle-ausfluege
echo   /de/phu-quoc/wo-uebernachten
echo.
echo It will NOT deploy automatically.
echo It will NOT change prices, bookings, admin or partner logic.
echo.
pause

set "SELF=%~f0"
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$raw=[IO.File]::ReadAllText($env:SELF); $m='#'+'__GVS_PS_PAYLOAD__'; $i=$raw.LastIndexOf($m); if($i -lt 0){Write-Error 'Payload marker not found'; exit 2}; $code=$raw.Substring($i+$m.Length); & ([ScriptBlock]::Create($code))"
set "EXIT_CODE=%ERRORLEVEL%"

echo.
if not "%EXIT_CODE%"=="0" (
  echo [ERROR] Installer stopped with code %EXIT_CODE%.
  echo Check the message above. Existing target files were backed up before overwrite.
) else (
  echo [OK] German Central Vietnam + Phu Quoc landing pages are ready locally.
)
echo.
pause
endlocal
exit /b %EXIT_CODE%

#__GVS_PS_PAYLOAD__

$ErrorActionPreference = "Stop"

function Step([string]$Text) {
  Write-Host ""
  Write-Host ("==> " + $Text) -ForegroundColor Cyan
}

function Find-Root {
  $candidates = New-Object System.Collections.Generic.List[string]
  $selfDir = Split-Path -Parent $env:SELF
  if ($selfDir) { $candidates.Add($selfDir) }
  try {
    $cwd = (Get-Location).Path
    if ($cwd -and -not $candidates.Contains($cwd)) { $candidates.Add($cwd) }
  } catch {}
  if ($env:USERPROFILE) {
    $known = Join-Path $env:USERPROFILE "Documents\GitHub\govietstay-main-website"
    if (-not $candidates.Contains($known)) { $candidates.Add($known) }
  }

  foreach ($candidate in $candidates) {
    $pkg = Join-Path $candidate "package.json"
    if (Test-Path $pkg) {
      try {
        $json = Get-Content -LiteralPath $pkg -Raw | ConvertFrom-Json
        if ($json.name -eq "govietstay-main-website") { return (Resolve-Path $candidate).Path }
      } catch {}
    }
  }

  Write-Host ""
  Write-Host "GoVietStay repository was not found automatically." -ForegroundColor Yellow
  $manual = Read-Host "Paste full path to govietstay-main-website"
  if ([string]::IsNullOrWhiteSpace($manual)) { throw "No repository path provided." }
  $manual = $manual.Trim('"')
  $pkg = Join-Path $manual "package.json"
  if (-not (Test-Path $pkg)) { throw "package.json not found in selected folder." }
  $json = Get-Content -LiteralPath $pkg -Raw | ConvertFrom-Json
  if ($json.name -ne "govietstay-main-website") { throw "Selected folder is not govietstay-main-website." }
  return (Resolve-Path $manual).Path
}

$root = Find-Root
Set-Location $root
Step "Repository verified"
Write-Host $root -ForegroundColor Green

$appRoot = Join-Path $root "app"
if (-not (Test-Path $appRoot)) {
  $appRoot = Join-Path $root "src\app"
}
if (-not (Test-Path $appRoot)) { throw "Next.js App Router folder not found." }

$logo = Join-Path $root "public\brand\govietstay-official-logo.jpg"
if (-not (Test-Path $logo)) {
  throw "Official GoVietStay logo missing: public\brand\govietstay-official-logo.jpg. Installer stopped instead of guessing a logo."
}
Write-Host "PASS: official GoVietStay logo exists." -ForegroundColor Green

try {
  $branch = (git branch --show-current 2>$null).Trim()
  if ($branch) { Write-Host ("Git branch: " + $branch) -ForegroundColor DarkGray }
} catch {}

$stamp = Get-Date -Format "yyyyMMdd-HHmmss"
$backup = Join-Path $root (".govietstay-backups\de-german-market-" + $stamp)
New-Item -ItemType Directory -Path $backup -Force | Out-Null

Step "Loading German landing bundle"
$bundleJson = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String(""))
$bundle = $bundleJson | ConvertFrom-Json

Step "Backing up existing target files"
$backedUp = 0
foreach ($item in $bundle) {
  $relative = [string]$item.path
  if ($relative.StartsWith("app\") -and ($appRoot -ne (Join-Path $root "app"))) {
    $relative = "src\" + $relative
  }
  $dest = Join-Path $root $relative
  if (Test-Path $dest) {
    $backupDest = Join-Path $backup $relative
    New-Item -ItemType Directory -Path (Split-Path -Parent $backupDest) -Force | Out-Null
    Copy-Item -LiteralPath $dest -Destination $backupDest -Force
    $backedUp++
  }
}
$sitemap = Join-Path $appRoot "sitemap.ts"
if (Test-Path $sitemap) {
  $sitemapBackup = Join-Path $backup (($sitemap.Substring($root.Length)).TrimStart('\'))
  New-Item -ItemType Directory -Path (Split-Path -Parent $sitemapBackup) -Force | Out-Null
  Copy-Item -LiteralPath $sitemap -Destination $sitemapBackup -Force
  $backedUp++
}
Write-Host ("Backup folder: " + $backup) -ForegroundColor Yellow
Write-Host ("Files backed up: " + $backedUp) -ForegroundColor DarkGray

Step "Writing German landing pages"
foreach ($item in $bundle) {
  $relative = [string]$item.path
  if ($relative.StartsWith("app\") -and ($appRoot -ne (Join-Path $root "app"))) {
    $relative = "src\" + $relative
  }
  $dest = Join-Path $root $relative
  $parent = Split-Path -Parent $dest
  New-Item -ItemType Directory -Path $parent -Force | Out-Null
  $bytes = [Convert]::FromBase64String([string]$item.b64)
  [IO.File]::WriteAllBytes($dest, $bytes)
  Write-Host ("Written: " + $relative) -ForegroundColor Green
}

Step "Updating root sitemap safely"
if (-not (Test-Path $sitemap)) { throw "app/sitemap.ts not found. German pages were written, but sitemap cannot be patched safely." }

$sm = [IO.File]::ReadAllText($sitemap)
$importLine = 'import { germanSeoPages } from "./de/seo";'
if (-not $sm.Contains($importLine)) {
  $firstConst = $sm.IndexOf("const BASE_URL")
  if ($firstConst -lt 0) { throw "Could not locate sitemap import boundary." }
  $sm = $sm.Insert($firstConst, $importLine + "`r`n")
}

if (-not $sm.Contains("const germanPages: MetadataRoute.Sitemap")) {
  $marker = "  const secretPages: MetadataRoute.Sitemap"
  $idx = $sm.IndexOf($marker)
  if ($idx -lt 0) { throw "Could not locate secretPages marker in sitemap. Refusing a blind patch." }

  $block = @'
  const germanPages: MetadataRoute.Sitemap = germanSeoPages.map((page) => {
    const deUrl = page.path ? `${BASE_URL}/de/${page.path}` : `${BASE_URL}/de`;
    const languages: Record<string, string> = {
      "de-DE": deUrl,
      "x-default": page.en ? `${BASE_URL}${page.en}` : deUrl,
    };
    if (page.en) languages.en = `${BASE_URL}${page.en}`;

    return {
      url: deUrl,
      lastModified: new Date(`${page.updated}T00:00:00.000Z`),
      changeFrequency: page.changeFrequency,
      priority: page.priority,
      alternates: { languages },
    };
  });

'@
  $sm = $sm.Insert($idx, $block)
}

if (-not $sm.Contains("    ...germanPages,")) {
  $needle = "    ...secretPages,"
  if (-not $sm.Contains($needle)) { throw "Could not locate sitemap return list marker." }
  $sm = $sm.Replace($needle, "    ...germanPages,`r`n" + $needle)
}

[IO.File]::WriteAllText($sitemap, $sm, (New-Object Text.UTF8Encoding($false)))
Write-Host "PASS: German pages added to root sitemap." -ForegroundColor Green

Step "Safety and branding checks"
$required = @(
  "de\page.tsx",
  "de\zentralvietnam-private-touren\page.tsx",
  "de\da-nang\page.tsx",
  "de\hoi-an\page.tsx",
  "de\hue\page.tsx",
  "de\zentralvietnam-reiseplan\page.tsx",
  "de\da-nang-regenzeit\page.tsx",
  "de\phu-quoc\page.tsx",
  "de\phu-quoc\beste-reisezeit\page.tsx",
  "de\phu-quoc\3-oder-4-inseln\page.tsx",
  "de\phu-quoc\mit-kindern\page.tsx",
  "de\phu-quoc\individuelle-ausfluege\page.tsx",
  "de\phu-quoc\wo-uebernachten\page.tsx"
)
foreach ($r in $required) {
  $f = Join-Path $appRoot $r
  if (-not (Test-Path $f)) { throw ("Missing route file: " + $r) }
}
Write-Host "PASS: all German routes exist." -ForegroundColor Green

$shared = [IO.File]::ReadAllText((Join-Path $appRoot "de\_shared\GermanLanding.tsx"))
if (-not $shared.Contains("/brand/govietstay-official-logo.jpg")) { throw "Official logo reference missing." }
if (-not $shared.Contains("84937762607")) { throw "GoVietStay WhatsApp number missing." }
if (-not $shared.Contains("Erst informieren, dann entscheiden")) { throw "Help-first content rule missing." }
Write-Host "PASS: official logo + GoVietStay WhatsApp + help-first rule." -ForegroundColor Green

$allGerman = ""
foreach ($r in $required) { $allGerman += [IO.File]::ReadAllText((Join-Path $appRoot $r)) + "`n" }
$allGerman += $shared

if ($allGerman -match "(?i)\b(join[- ]?in|group tour|gruppentour|sammeltour)\b") {
  throw "Private-only check failed: group/join-in wording detected."
}
Write-Host "PASS: German market remains private-tour focused." -ForegroundColor Green

if ($allGerman -match "(?i)\b(?:VND|USD|EUR)\s*[0-9]|[$€]\s*[0-9]") {
  throw "Price-like content detected. German guides should stay information-first."
}
Write-Host "PASS: no public price selling inserted." -ForegroundColor Green

$sm2 = [IO.File]::ReadAllText($sitemap)
if (-not $sm2.Contains("...germanPages")) { throw "Sitemap German page spread missing." }
Write-Host "PASS: sitemap verification complete." -ForegroundColor Green

Step "Done"
Write-Host "German market landing pages are installed locally." -ForegroundColor Green
Write-Host "No Vercel deployment was triggered automatically." -ForegroundColor Yellow
Write-Host "Reason: keep the existing working production flow safe; use your normal GoVietStay deploy BAT after review." -ForegroundColor DarkGray
Write-Host ""
Write-Host "Recommended preview URLs after deployment:" -ForegroundColor Cyan
Write-Host "  /de"
Write-Host "  /de/da-nang"
Write-Host "  /de/zentralvietnam-reiseplan"
Write-Host "  /de/phu-quoc"
Write-Host "  /de/phu-quoc/beste-reisezeit"
Write-Host "  /de/phu-quoc/individuelle-ausfluege"

