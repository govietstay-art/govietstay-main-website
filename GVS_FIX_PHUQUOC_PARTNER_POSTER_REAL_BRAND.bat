@echo off
setlocal EnableExtensions
title GoVietStay - Fix Phu Quoc Partner Poster
color 0F

if /I "%~1"=="TEMP_RUN" goto TEMP_RUN

set "REPO=%~dp0"
set "TEMPSCRIPT=%TEMP%\GVS_PQ_POSTER_FIX_%RANDOM%_%RANDOM%.bat"
copy /Y "%~f0" "%TEMPSCRIPT%" >nul
if errorlevel 1 (
  echo ERROR: Cannot create temporary runner.
  pause
  exit /b 1
)
start "GoVietStay Phu Quoc Poster Fix" cmd /k ""%TEMPSCRIPT%" TEMP_RUN "%REPO%""
exit /b

:TEMP_RUN
set "REPO=%~2"
cd /d "%REPO%"

set "TARGET=components\admin-v5\PhuQuocPartnerPosterInline.tsx"
set "TMP=%TEMP%\PhuQuocPartnerPosterInline_new.tsx"

echo ============================================================
echo GOVIETSTAY - PHU QUOC PARTNER POSTER FIX
echo ============================================================
echo.
echo This patch changes ONLY:
echo %TARGET%
echo.
echo It uses existing local assets:
echo  - /brand/govietstay-official-logo.jpg
echo  - /phu-quoc/ru-cluster/hero-islands.png
echo  - /phu-quoc/ru-cluster/hero-sunset.png
echo.
echo No force push.
echo.

where git >nul 2>&1
if errorlevel 1 goto NOGIT

git rev-parse --is-inside-work-tree >nul 2>&1
if errorlevel 1 goto NOTREPO

echo [1/8] Save uncommitted work...
git rebase --abort >nul 2>&1
git stash push -u -m "GVS safety stash before Phu Quoc poster fix"
if errorlevel 1 goto STASHFAIL
echo OK.
echo.

echo [2/8] Sync main...
git fetch origin
if errorlevel 1 goto SYNCFAIL
git checkout main
if errorlevel 1 goto SYNCFAIL
git pull --ff-only origin main
if errorlevel 1 goto SYNCFAIL
echo OK.
echo.

echo [3/8] Create backup branch...
set "BACKUP=backup-pq-poster-%RANDOM%-%RANDOM%"
git branch "%BACKUP%"
if errorlevel 1 goto BACKUPFAIL
echo Backup: %BACKUP%
echo.

echo [4/8] Write the corrected poster component...
powershell -NoProfile -ExecutionPolicy Bypass -Command ^
  "$b64=''; [IO.File]::WriteAllBytes('%TMP%', [Convert]::FromBase64String($b64))"
if errorlevel 1 goto WRITEFAIL

copy /Y "%TMP%" "%TARGET%" >nul
if errorlevel 1 goto WRITEFAIL

echo Changed files:
git status --short
echo.

echo [5/8] Production build...
call npm run build
if errorlevel 1 goto BUILDFAIL
echo BUILD OK.
echo.

echo [6/8] Commit...
git add "%TARGET%"
git commit -m "fix(admin): redesign Phu Quoc partner poster with real brand assets"
if errorlevel 1 goto COMMITFAIL
echo Commit OK.
echo.

echo [7/8] Push to GitHub main...
git push origin main
if errorlevel 1 goto PUSHFAIL
echo PUSH OK.
echo.

echo [8/8] Restore previous local work...
git stash pop
if errorlevel 1 goto POPWARN
echo Restore OK.
echo.

echo ============================================================
echo SUCCESS
echo Phu Quoc Partner Poster was updated correctly.
echo Vercel should deploy automatically.
echo ============================================================
git log -1 --oneline
git status
goto END

:NOGIT
echo ERROR: Git not found.
goto END

:NOTREPO
echo ERROR: Put this BAT in the GoVietStay repository folder.
goto END

:STASHFAIL
echo ERROR: Could not save local work. Nothing changed.
goto END

:SYNCFAIL
echo ERROR: Could not sync main. Nothing pushed.
git stash pop
goto END

:BACKUPFAIL
echo ERROR: Could not create backup branch.
git stash pop
goto END

:WRITEFAIL
echo ERROR: Could not write poster component.
git reset --hard HEAD
git stash pop
goto END

:BUILDFAIL
echo.
echo ============================================================
echo BUILD FAILED - NOTHING PUSHED
echo Rolling back poster file...
echo ============================================================
git reset --hard HEAD
git stash pop
goto END

:COMMITFAIL
echo ERROR: Commit failed. Nothing pushed.
git reset --hard HEAD
git stash pop
goto END

:PUSHFAIL
echo.
echo ============================================================
echo PUSH FAILED
echo No force push was used.
echo New commit is still local.
echo ============================================================
git status
goto END

:POPWARN
echo.
echo ============================================================
echo PUSH SUCCEEDED.
echo Only restoring old local files has a conflict.
echo Do not delete anything. Send me a screenshot.
echo ============================================================
git status
goto END

:END
del /q "%TMP%" >nul 2>&1
echo.
echo ------------------------------------------------------------
echo Window stays open.
echo If you see ERROR or BUILD FAILED, send me a screenshot.
echo ------------------------------------------------------------
echo.
