@echo off
setlocal EnableExtensions EnableDelayedExpansion
chcp 65001 >nul
title GoVietStay - Booking Deposit + Copy Customer Driver

echo.
echo ================================================================
echo  GOVIETSTAY - DEPOSIT + COPY BOOKING / DRIVER - ONE CLICK
echo ================================================================
echo.
echo  Adds:
echo  - Deposit / Da coc + Balance auto calculation
echo  - Customer copy: English / Russian
echo  - Driver copy: Vietnamese / English
echo  - Works for Owner, Admin, Sales and Desk staff
echo  - Keeps finance / guide editing Admin-only
echo.

set "PROJECT="
for /f "delims=" %%I in ('git rev-parse --show-toplevel 2^>nul') do set "PROJECT=%%I"
if not defined PROJECT if exist "%USERPROFILE%\govietstay-main-website\.git" set "PROJECT=%USERPROFILE%\govietstay-main-website"
if not defined PROJECT if exist "%USERPROFILE%\Desktop\govietstay-main-website\.git" set "PROJECT=%USERPROFILE%\Desktop\govietstay-main-website"
if not defined PROJECT if exist "%USERPROFILE%\Documents\govietstay-main-website\.git" set "PROJECT=%USERPROFILE%\Documents\govietstay-main-website"

if not defined PROJECT (
  echo Khong tu tim thay thu muc project.
  set /p "PROJECT=Dan duong dan thu muc govietstay-main-website roi Enter: "
)

if not exist "%PROJECT%\.git" (
  echo.
  echo [STOP] Khong tim thay Git project: %PROJECT%
  pause
  exit /b 1
)

set "WORKTREE=%TEMP%\gvs_ops_deposit_share_%RANDOM%_%RANDOM%"
set "GVS_WORKTREE=%WORKTREE%"

echo [1/7] Fetch origin/main...
git -C "%PROJECT%" fetch origin main
if errorlevel 1 goto FAIL

echo [2/7] Tao worktree sach, khong dung cham code dang lam...
git -C "%PROJECT%" worktree add --detach "%WORKTREE%" origin/main
if errorlevel 1 goto FAIL

echo [3/7] Patch Operations Center...
powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
if errorlevel 1 goto FAIL_WORKTREE

if exist "%PROJECT%\.env.local" copy /Y "%PROJECT%\.env.local" "%WORKTREE%\.env.local" >nul
if exist "%PROJECT%\node_modules" (
  echo [4/7] Dung node_modules hien tai de build nhanh...
  cmd /c mklink /J "%WORKTREE%\node_modules" "%PROJECT%\node_modules" >nul 2>&1
) else (
  echo [4/7] Cai dependencies...
  pushd "%WORKTREE%"
  if exist package-lock.json (call npm ci) else (call npm install)
  if errorlevel 1 (popd & goto FAIL_WORKTREE)
  popd
)

echo [5/7] Production build check...
pushd "%WORKTREE%"
call npm run build
if errorlevel 1 (
  popd
  echo.
  echo [STOP] BUILD FAILED. Khong push production.
  goto FAIL_WORKTREE
)
popd

echo [6/7] Commit ONLY OperationsCenter.tsx...
git -C "%WORKTREE%" add -- "components/admin-v5/OperationsCenter.tsx"
git -C "%WORKTREE%" diff --cached --quiet
if not errorlevel 1 (
  echo [OK] Code da co san tren origin/main. Khong can commit.
  goto CLEAN_SUCCESS
)
git -C "%WORKTREE%" -c user.name="GoVietStay Installer" -c user.email="govietstay@gmail.com" commit -m "feat(operations): deposit and booking-driver copy tools" -- "components/admin-v5/OperationsCenter.tsx"
if errorlevel 1 goto FAIL_WORKTREE

echo [7/7] Push main - Vercel se tu deploy...
git -C "%WORKTREE%" push origin HEAD:main
if errorlevel 1 goto FAIL_WORKTREE

:CLEAN_SUCCESS
echo.
echo ================================================================
echo  SUCCESS
echo ================================================================
echo  Mo sau khi Vercel deploy xong:
echo  https://www.govietstay.com/admin/operations
echo.
echo  Test nhanh:
echo  1. + Booking
  echo 2. Nhap Gia ban + Deposit - Balance tu tinh
  echo 3. Luu booking
  echo 4. Nut Khach: EN / RU
  echo 5. Nut Driver: VI / EN
  echo 6. Sales / Desk cung co the tao booking va copy thong tin

echo.
git -C "%PROJECT%" worktree remove --force "%WORKTREE%" >nul 2>&1
git -C "%PROJECT%" worktree prune >nul 2>&1
pause
exit /b 0

:FAIL_WORKTREE
echo.
echo [STOP] Co loi. Khong push production.
git -C "%PROJECT%" worktree remove --force "%WORKTREE%" >nul 2>&1
git -C "%PROJECT%" worktree prune >nul 2>&1
pause
exit /b 1

:FAIL
echo.
echo [STOP] Khong the chuan bi source. Khong co thay doi nao duoc push.
pause
exit /b 1
