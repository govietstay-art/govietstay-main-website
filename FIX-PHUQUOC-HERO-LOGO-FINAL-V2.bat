@echo off
setlocal EnableExtensions EnableDelayedExpansion
chcp 65001 >nul
title GoVietStay - FINAL Remove Hero Logo + Push

set "GIT_PAGER=cat"
set "PAGER=cat"

set "REPO=%USERPROFILE%\Documents\GitHub\govietstay-main-website"
if not exist "%REPO%\package.json" (
  if exist "%USERPROFILE%\OneDrive\Documents\GitHub\govietstay-main-website\package.json" (
    set "REPO=%USERPROFILE%\OneDrive\Documents\GitHub\govietstay-main-website"
  ) else if exist "%CD%\package.json" (
    set "REPO=%CD%"
  ) else (
    echo [STOP] Khong tim thay govietstay-main-website.
    pause
    exit /b 1
  )
)

cd /d "%REPO%"
set "TARGET=components\PhuQuocJohnsCatalog.tsx"

echo.
echo ============================================================
echo   GOVIETSTAY - FINAL REMOVE HERO LOGO
echo   Khong mo pager / khong dung o man hinh diff
echo ============================================================
echo.

for /f "delims=" %%B in ('git branch --show-current') do set "BRANCH=%%B"
if /i not "!BRANCH!"=="main" (
  echo [STOP] Branch hien tai: !BRANCH! - can main.
  pause
  exit /b 1
)

REM Do not interfere with anything already staged
git diff --cached --quiet
if errorlevel 1 (
  echo [STOP] Dang co file STAGED tu truoc. Em khong dong vao de tranh commit nham.
  git status --short
  pause
  exit /b 1
)

echo [1/6] Kiem tra va sua DUNG logo de tren anh hero...
set "GVS_ROOT=%REPO%"
powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
if errorlevel 1 (
  echo.
  echo [STOP] Patch khong an toan. KHONG commit / KHONG push.
  pause
  exit /b 1
)

echo.
echo [2/6] Thay doi:
git --no-pager diff --stat -- "%TARGET%"
git --no-pager diff --unified=0 -- "%TARGET%"

echo.
echo [3/6] Build production...
if exist ".next" rmdir /s /q ".next"
call npm run build
if errorlevel 1 (
  echo.
  echo [FAIL] BUILD FAIL - KHONG commit, KHONG push.
  pause
  exit /b 1
)
echo [OK] BUILD PASS.

echo.
echo [4/6] Stage CHI component Phu Quoc...
git add -- "%TARGET%"

for /f %%C in ('git diff --cached --name-only ^| find /c /v ""') do set "COUNT=%%C"
if not "!COUNT!"=="1" (
  echo [STOP] Expected exactly 1 staged file, found !COUNT!.
  git --no-pager diff --cached --name-status
  git reset
  pause
  exit /b 1
)

for /f "delims=" %%F in ('git diff --cached --name-only') do set "STAGED=%%F"
if /i not "!STAGED!"=="components/PhuQuocJohnsCatalog.tsx" (
  echo [STOP] Unexpected staged file: !STAGED!
  git reset
  pause
  exit /b 1
)

echo.
echo [5/6] Commit...
git commit -m "fix: remove duplicate Phu Quoc logo from hero image"
if errorlevel 1 (
  echo [STOP] Commit failed. KHONG push.
  pause
  exit /b 1
)

echo.
echo [6/6] Push origin main...
git push origin main
if errorlevel 1 (
  echo [STOP] Push failed. Commit van nam tren may.
  pause
  exit /b 1
)

echo.
echo ============================================================
echo   SUCCESS - DA PUSH LEN GITHUB
echo ============================================================
git --no-pager log -1 --oneline
echo.
echo Vercel se auto-deploy commit tren.
echo Live:
echo https://www.govietstay.com/ru/tours/phu-quoc
echo https://www.govietstay.com/tours/phu-quoc
echo.
echo Neu mo trang cu, bam Ctrl+F5 de bo cache.
pause
